{
  "name": "mt5-fleet-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "MT5 Fleet Dashboard — production multi-account MT5 monitoring platform (web + desktop + telemetry agent on one backend).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:ws": "node --env-file=.env --conditions=react-server --import tsx server/websocket/standalone.ts",
    "dev:full": "concurrently -k -n web,ws \"npm run dev\" \"npm run dev:ws\"",
    "build": "prisma generate && node scripts/copy-agent.cjs && next build && node scripts/prepare-standalone.cjs",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "icons": "node scripts/generate-icons.cjs",
    "ws": "node --env-file=.env --conditions=react-server --import tsx server/websocket/standalone.ts",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:compile && electron dist-electron/electron/main.js",
    "package:win": "npm run desktop:prepare && electron-builder --win --publish never",
    "package:mac": "npm run desktop:prepare && electron-builder --mac --publish never",
    "package:linux": "npm run desktop:prepare && electron-builder --linux --publish never",
    "package": "npm run package:win",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:integration": "node scripts/integration-test.mjs",
    "desktop:prepare": "npm run icons && node scripts/desktop-config.cjs && npm run electron:compile",
    "postinstall": "prisma generate",
    "build:vercel": "prisma generate && prisma migrate deploy && node scripts/copy-agent.cjs && next build",
    "dev:local": "node scripts/local-dev.mjs",
    "predev": "node scripts/copy-agent.cjs"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@prisma/client": "^6.16.2",
    "@vercel/functions": "^3.9.11",
    "bcryptjs": "^3.0.2",
    "electron-updater": "^6.8.9",
    "jose": "^6.1.0",
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "ws": "^8.19.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    "defaults"
  ],
  "main": "dist-electron/electron/main.js",
  "overrides": {
    "postcss": "^8.5.29",
    "deepmerge-ts": "^8.0.2",
    "shell-quote": "^1.12.0",
    "tar": "^7.5.22",
    "builder-util-runtime": "^9.7.0",
    "cacheable-request": "^10.2.14"
  }
}
