# Local web setup: copy to .env, fill these values, npm run db:migrate, npm run dev.
# Or npm run dev:local creates a private local PostgreSQL cluster and this file for you.
# Production requires EXTERNAL persistent PostgreSQL; local embedded PG is development only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fleet?sslmode=require&connection_limit=5"
# Generate each independently: openssl rand -base64 48
AUTH_SECRET=""
AGENT_SECRET=""
CRON_SECRET=""
# Local: http://localhost:3000. Vercel: your canonical HTTPS domain.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional additional browser origins. Same-origin web/desktop requires none.
# ALLOWED_ORIGINS="https://your-preview.vercel.app"
# Default WebSocket is same-origin /api/ws. next dev uses SSE/poll fallback.
# For npm run dev:full, enable this and restart Next:
# NEXT_PUBLIC_WS_URL="ws://localhost:3001/api/ws"
# WS_PORT=3001
# PAIRING_TTL_MINUTES=15
# AGENT_HEARTBEAT_SECONDS=5
# AGENT_SNAPSHOT_SECONDS=5
# Build-time desktop origin. Leave unset (and APP_URL local) for first-run setup.
# ELECTRON_APP_URL="https://your-dashboard.vercel.app"
# Optional public HTTPS generic electron-updater feed (no secret tokens).
# APP_UPDATE_URL="https://downloads.example.com/mt5-fleet"
